# Copy this file to .env and fill in your own Supabase project's values.
# Get these from Project Settings > API in your Supabase dashboard.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Alternative (requires you to set up Row Level Security policies yourself --
# see README). Not read by the app's default code path.
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key
